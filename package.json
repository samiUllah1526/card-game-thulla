    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
